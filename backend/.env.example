# Backend env for LOCAL (non-Docker) runs. In Docker these are injected by
# docker-compose from the root .env. Copy to backend/.env only if running
# `npm run dev` directly on the host.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://lanari:change_me_in_prod@localhost:5432/lanari_portal?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:8080

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=lanari
MINIO_SECRET_KEY=change_me_in_prod
MINIO_BUCKET=lanari-documents

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
