# ──────────────────────────────────────────────────────────────────────────
# Lanari Tech Portal — root environment template
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Consumed by docker-compose.yml / docker-compose.prod.yml.
# ──────────────────────────────────────────────────────────────────────────

# ---- Edge / public ----
# Host port the Nginx edge proxy is published on.
EDGE_HTTP_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=lanari
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=lanari_portal
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage for document uploads) ----
MINIO_ROOT_USER=lanari
MINIO_ROOT_PASSWORD=change_me_in_prod
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lanari-documents

# ---- Backend API ----
BACKEND_PORT=4000
NODE_ENV=development

# JWT secrets — generate strong random values for production
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Origin allowed by CORS (the edge proxy origin in dev)
CORS_ORIGIN=http://localhost:8080

# AI provider — Claude is the default model provider for portal AI features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Frontend ----
# Base URL the browser uses for API calls. Same-origin via the edge proxy.
VITE_API_BASE_URL=/api
